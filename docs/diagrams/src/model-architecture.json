  "cards": [
    {
      "dot": "cyan",
      "title": "U shape",
      "items": [
        "Four stride-2 sparse convolutions take the voxel size from 10 cm to 1.6 m",
        "Inverse sparse convolutions reuse the encoder's indices, restoring exactly the same voxels",
        "Each decoder stage concatenates encoder features of the same resolution"
      ]
    },
    {
      "dot": "emerald",
      "title": "Building blocks",
      "items": [
        "Residual block: two 3×3×3 submanifold convolutions with BatchNorm and ReLU",
        "23 M parameters at width 1.0; the narrow variant (width 0.5) has 5.8 M",
        "Runs as an fp16 model: 15 ms per scan on an RTX 5060 Ti"
      ]
    },
    {
      "dot": "amber",
      "title": "Input and output",
      "items": [
        "Five features per voxel: x, y, z, remission and range / 50",
        "Each point takes its voxel's class; the softmax confidence is kept",
        "Object clustering ignores low-confidence vehicle and pedestrian points"
      ]
    }
  ]
