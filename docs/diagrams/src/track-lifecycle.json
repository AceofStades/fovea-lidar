  "cards": [
    {
      "dot": "cyan",
      "title": "Becoming a track",
      "items": [
        "Only confident vehicle and pedestrian points are clustered",
        "A box needs enough points and a plausible size for its class",
        "A cluster within 2.5 m of a same-class track continues it"
      ]
    },
    {
      "dot": "emerald",
      "title": "Static or moving",
      "items": [
        "Moving when the object no longer overlaps its own voxels from 0.5 s ago (smoothed evidence above 0.5)",
        "Or when its least-squares speed tops 4 m/s after 4 frames",
        "Evidence only updates where that area was actually observed"
      ]
    },
    {
      "dot": "rose",
      "title": "Ending",
      "items": [
        "A track that finds no match in a frame is dropped at once",
        "Moving tracks mark their points, so the map tints those cells"
      ]
    }
  ]
