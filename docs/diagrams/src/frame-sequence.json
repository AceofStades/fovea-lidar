  "cards": [
    {
      "dot": "cyan",
      "title": "Frame loop",
      "items": [
        "The server paces frames to the replay rate, 10 Hz by default",
        "pipe.step runs in a worker thread; a lock keeps several tabs from interleaving steps",
        "Stage timings travel with every frame and feed the latency panels"
      ]
    },
    {
      "dot": "emerald",
      "title": "Binary frame",
      "items": [
        "One message: a JSON header plus typed arrays for cells, points and trajectory",
        "Cells arrive as x, y, z0, z1, size plus category, drivability, ring and moving bytes",
        "The browser copies the arrays straight into GPU buffers; shaders do the colouring"
      ]
    },
    {
      "dot": "amber",
      "title": "Inspection",
      "items": [
        "Hover raycasts the ground plane in the sensor frame",
        "The server maps the point into the world-anchored grid and returns that cell's layers"
      ]
    }
  ]
