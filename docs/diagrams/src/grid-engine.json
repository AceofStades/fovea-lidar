  "cards": [
    {
      "dot": "cyan",
      "title": "Exact indexing",
      "items": [
        "A point's ring and its cell come from the same integer, so it lands in exactly one cell",
        "Ring edges sit on coarse-cell edges: every coarse cell is an exact union of fine cells",
        "World anchoring keeps every cell boundary fixed while the rings scroll with the vehicle"
      ]
    },
    {
      "dot": "emerald",
      "title": "2.5D layers",
      "items": [
        "Ground height is filled under cars and behind walls from neighbouring cells",
        "Clearance is the lowest obstacle point above ground; an overhang is passable only over seen ground",
        "Step height to the 3×3 neighbours marks curbs and pothole rims"
      ]
    },
    {
      "dot": "amber",
      "title": "Cost",
      "items": [
        "All layers for about 1.1 M fused points in roughly 7 ms on the GPU",
        "730 k cells × 11 bytes: 8 MB per map"
      ]
    }
  ]
